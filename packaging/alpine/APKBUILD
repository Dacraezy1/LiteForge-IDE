pkgname=liteforge
pkgver=1.0.0
pkgrel=0
pkgdesc="Featherweight, zero-bloat native C++ IDE"
url="https://github.com/Dacraezy1/LiteForge-IDE"
arch="x86_64 aarch64 armv7"
license="MIT"
depends="qt6-qtbase"
makedepends="cmake g++ qt6-qtbase-dev linux-headers"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/Dacraezy1/LiteForge-IDE/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/LiteForge-IDE-$pkgver"

build() {
    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build --parallel
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
