# Maintainer: Dacraezy1 <https://github.com/Dacraezy1/LiteForge-IDE>
pkgname=liteforge
pkgver=1.2.0
pkgrel=0
pkgdesc="Featherweight, zero-bloat native C++ IDE"
url="https://github.com/Dacraezy1/LiteForge-IDE"
arch="all"
license="GPL-3.0-only"
depends="qt6-qtbase"
makedepends="cmake samurai qt6-qtbase-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/LiteForge-IDE-$pkgver"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DENABLE_TESTING=ON
	cmake --build build
}

check() {
	QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

# Run `abuild checksum` after the v$pkgver tag exists to fill this in.
sha512sums="2e0d0d2a18f42e7065c64409bb5c8da1579e60a653e905e19e14f4103ece38d7a1683a01103cefd15ac216a7d19f3879fdb55d8d935181ac51eb7374fbd27d91  liteforge-1.2.0.tar.gz"
